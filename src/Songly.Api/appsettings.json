{
  "ConnectionStrings": {
    "Songly": "Host=localhost;Port=5432;Database=songly;Username=songly;Password=songly",
    "Redis": "localhost:6379"
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Songly": {
    "Matching": {
      "ConfidencePrior": 2.0
    },
    "Notification": {
      "ModerationMail": {
        "ModeratorInterval": "00:15:00"
      },
      "Push": {
        "MaxDevicesPerUser": 10
      }
    },
    "NowPlaying": {
      "CacheTtl": "00:00:45",
      "ManualStatusTtl": "03:00:00",
      "OAuthStateTtl": "00:10:00",
      "ConnectResultUrl": "songly://now-playing/spotify",
      "TokenEncryptionKey": "ZGV2LW9ubHktdG9rZW4tZW5jcnlwdGlvbi1rZXktMzI=",
      "Stream": {
        "Timeout": "00:30:00",
        "MaxPerUser": 3,
        "HeartbeatEnabled": true,
        "HeartbeatInterval": "00:00:20",
        "AnnouncedTtl": "06:00:00"
      },
      "Poll": {
        "Enabled": true,
        "Interval": "00:00:30",
        "LockTtl": "00:00:25",
        "ProviderBackoff": "00:01:00"
      },
      "Spotify": {
        "ClientId": "dev-client-id",
        "ClientSecret": "dev-client-secret",
        "RedirectUri": "http://localhost:8080/api/v1/now-playing/spotify/callback",
        "Timeout": "00:00:10"
      }
    },
    "Content": {
      "Report": {
        "Limit": 20,
        "Window": "01:00:00",
        "DismissalPenalty": 5,
        "MinLimit": 1,
        "HistoryWindow": "90.00:00:00"
      },
      "PostImage": {
        "MaxPending": 10,
        "PendingTtl": "1.00:00:00",
        "CleanupBatchSize": 500,
        "CleanupEnabled": true,
        "CleanupInterval": "01:00:00"
      }
    },
    "Security": {
      "ProductionSecretsRequired": false,
      "Jwt": {
        "Secret": "dev-only-secret-change-me-in-every-real-environment-32bytes+",
        "AccessTokenTtl": "00:15:00",
        "RefreshTokenTtl": "30.00:00:00"
      },
      "SessionCleanup": {
        "Enabled": true,
        "Interval": "01:00:00",
        "Retention": "7.00:00:00",
        "BatchSize": 5000,
        "MaxBatchesPerRun": 20
      },
      "Registration": {
        "Ttl": "1.00:00:00",
        "ResendInterval": "00:01:00",
        "VerificationUrl": "songly://verify-email?token={token}",
        "CleanupEnabled": true,
        "CleanupInterval": "01:00:00"
      },
      "PasswordReset": {
        "Ttl": "00:30:00",
        "ResendInterval": "00:01:00",
        "ResetUrl": "songly://reset-password?token={token}"
      },
      "AccountDeletion": {
        "Ttl": "01:00:00",
        "ResendInterval": "00:01:00",
        "ConfirmUrl": "http://localhost:8080/account-deletion/confirm?token={token}"
      }
    },
    "Storage": {
      "Bucket": "songly-media",
      "Region": "auto",
      "Endpoint": "http://localhost:9000",
      "AccessKey": "songly",
      "SecretKey": "songly-dev-secret",
      "PublicBaseUrl": "http://localhost:9000/songly-media",
      "PathStyleAccess": true,
      "Timeout": "00:00:10"
    },
    "Profile": {
      "GenrePopularity": {
        "Ttl": "01:00:00"
      }
    },
    "Push": {
      "Provider": "log",
      "FcmCredentialsJson": null
    },
    "Mail": {
      "Provider": "log",
      "From": "no-reply@songly.io",
      "Smtp": {
        "Host": null,
        "Port": 587,
        "Username": null,
        "Password": null,
        "Timeout": "00:00:10"
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "AllowedHosts": "*"
}
