{
  "ConnectionStrings": {
    "Songly": "Host=localhost;Port=5432;Database=songly;Username=songly;Password=songly",
    "Redis": "localhost:6379"
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Songly": {
    "Security": {
      "ProductionSecretsRequired": false,
      "Jwt": {
        "Secret": "dev-only-secret-change-me-in-every-real-environment-32bytes+",
        "AccessTokenTtl": "00:15:00",
        "RefreshTokenTtl": "30.00:00:00"
      },
      "Registration": {
        "Ttl": "1.00:00:00",
        "ResendInterval": "00:01:00",
        "VerificationUrl": "songly://verify-email?token={token}",
        "CleanupEnabled": true,
        "CleanupInterval": "01:00:00"
      }
    },
    "Mail": {
      "Provider": "log",
      "From": "no-reply@songly.io",
      "Smtp": {
        "Host": null,
        "Port": 587,
        "Username": null,
        "Password": null,
        "Timeout": "00:00:10"
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "AllowedHosts": "*"
}
